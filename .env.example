# ============================================================
# Database (required)
# ============================================================
# Neon URLs often include ?sslmode=require&channel_binding=require — use single quotes
# if you `source .env` in zsh, otherwise `&` breaks parsing.
DATABASE_URL='postgresql://user:password@host:5432/dbname'

# Express API port (default 5001 in code — macOS AirPlay often uses 5000; Replit uses 5000 only on Replit via .replit).
# `npm run server:dev` sets DOTENV_CONFIG_OVERRIDE=true so values here override a stray shell PORT (e.g. PORT=5000).
PORT=5001

# MyMemory translation API (optional — raises free tier when set; see server/lib/translate/mymemory.ts)
# MYMEMORY_EMAIL=your-contact@example.com

# Metro / Expo dev server port (must match `npm run dev`; server proxies web to this port)
# EXPO_PORT=8081

# ============================================================
# Auth (required)
# ============================================================
SESSION_SECRET=your-random-secret-at-least-32-chars

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Domain (required)
# ============================================================
# Production frontend URL (Google OAuth return + Stripe success URLs; must match Google Cloud redirect URI host)
FRONTEND_URL=https://rawstock.live

# Public app origin (build-time). Used by getApiUrl() when EXPO_PUBLIC_API_URL is unset, and by getPublicWebOrigin() for Stripe (see lib/publicWebOrigin.ts). Production: usually same as API host, e.g. https://rawstock.live
EXPO_PUBLIC_DOMAIN=https://rawstock.live

# Local Web + Google OAuth: use Express as browser entry (see HANDOVER.md). Open http://localhost:5001 with server:dev + npm run web; set all three to 5001 and register http://localhost:5001/api/auth/google-callback in GCP.
# FRONTEND_URL=http://localhost:5001
# EXPO_PUBLIC_DOMAIN=http://localhost:5001
# EXPO_PUBLIC_API_URL=http://localhost:5001

# API server origin. When set, getApiUrl() uses this first. For Metro-only :8081 without OAuth on 8081, http://127.0.0.1:5001 is common.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5001

# ============================================================
# Cloudflare Stream (required for live streaming)
# ============================================================
# Dashboard → Stream → 任意の動画 → API で確認できる Account ID（32 文字の hex）
CLOUDFLARE_ACCOUNT_ID=
# API トークン（グローバル API キーではない）。権限例: Account → Stream → Edit など
# https://developers.cloudflare.com/stream/faq/#how-do-i-use-the-stream-api-with-account-api-tokens
CLOUDFLARE_STREAM_TOKEN=

# ============================================================
# AWS SDK (optional — fixes browser presigned PUT to R2 with @aws-sdk/client-s3 v3.729+)
# If unset, server/aws-sdk-env.ts defaults both to WHEN_REQUIRED so presigned URLs omit CRC query params.
# AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ============================================================
# Cloudflare R2 (required for file uploads)
# ============================================================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 API: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: browser-readable base URL after upload (R2 public access / r2.dev / custom domain).
# Without this, url returned from POST /api/upload-url may point at the private API host (403 for GET).
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxx.r2.dev
# R2 bucket CORS (Dashboard → R2 → bucket → CORS): allow your site origin, methods PUT GET HEAD,
# headers Content-Type (and Authorization only for your API origin, not the presigned PUT host).

# ============================================================
# Upstash Redis (required for caching / rate limiting)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Concert — external forms (optional; unset = in-app registration / staff API)
# ============================================================
# EXPO_PUBLIC_CONCERT_CREATE_URL=https://forms.gle/...
# EXPO_PUBLIC_CONCERT_STAFF_APPLY_URL=https://forms.gle/...
# EXPO_PUBLIC_CONCERT_STAFF_MANAGE_URL=https://docs.google.com/...
# Detail / concert ID is appended as ?concertId=123 when opening from concert detail.

# ============================================================
# Stripe (required for payments)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard → Developers → Webhooks → Signing secret (for POST /api/webhook/stripe)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Creator withdrawals (POST /api/revenue/withdraw): fee is deducted from the requested gross so the creator bears processing cost before Stripe.transfer.
# bps = basis points (100 = 1%). Example US card-like recovery on payout only: 290 + 30 cents.
# WITHDRAWAL_FEE_BPS=290
# WITHDRAWAL_FEE_FIXED_USD_CENTS=30
# Minimum net amount sent to Stripe Connect after fees (default 50 = $0.50)
# WITHDRAWAL_MIN_NET_TRANSFER_USD_CENTS=50

# ============================================================
# YouTube API (required for YouTube search)
# ============================================================
YOUTUBE_API_KEY=

# ============================================================
# Anthropic Claude API (optional)
# Used for AI moderation of reports. If unset, reports go to gray zone for manual review.
# ============================================================
# ANTHROPIC_API_KEY=

# ============================================================
# Templated.io (optional — required for AI Edit MP4 rendering)
# If unset, POST /api/ai-edit/jobs/:id/render returns 503
# ============================================================
TEMPLATED_API_KEY=

# Override the public API origin that Templated webhook calls back to.
# Defaults to FRONTEND_URL or rawstock.live if unset.
# TEMPLATED_WEBHOOK_BASE_URL=https://your-api.example.com

# ============================================================
# Admin (optional)
# ============================================================
# Email address of the site admin (used for certain admin-only features)
# ADMIN_EMAIL=
