{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://rawstock.live",
          "https://www.rawstock.live",
          "http://localhost:8081",
          "http://127.0.0.1:8081"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
